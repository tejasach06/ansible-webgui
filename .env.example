# PostgreSQL host used by api, worker, and beat.
POSTGRES_HOST=postgres
# PostgreSQL port.
POSTGRES_PORT=5432
# PostgreSQL database name.
POSTGRES_DB=ansible_webgui
# PostgreSQL user.
POSTGRES_USER=ansible
# PostgreSQL password. Change before starting the stack.
POSTGRES_PASSWORD=change-me
# Redis broker and SSE pub/sub URL.
REDIS_URL=redis://redis:6379/0
# JWT signing secret. Generate a long random value.
JWT_SECRET=change-me
# Fernet key for credential encryption. Generate with cryptography.fernet.Fernet.generate_key().
FERNET_KEY=change-me
# Initial admin username seeded on api startup.
BOOTSTRAP_ADMIN_USER=admin
# Initial admin password. Change after first login.
BOOTSTRAP_ADMIN_PASSWORD=change-me
# Set true when cookies travel only over HTTPS.
COOKIE_SECURE=false
# Git content root inside api/worker containers.
CONTENT_ROOT=/data/content
# Runner artifact root inside api/worker/beat containers.
ARTIFACT_ROOT=/data/artifacts
